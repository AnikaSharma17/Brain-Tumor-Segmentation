# Copy this file to `.env` and uncomment any value you want to override.
# All settings are optional; defaults live in src/brain_tumor_segmentation/config.py.
# `.env` is git-ignored.

# --- Data locations (relative to repo root or absolute) ---
# BTS_DATA_DIR=image_dataset
# BTS_IMAGE_DIR=image_dataset/images
# BTS_MASK_DIR=image_dataset/masks

# --- Output location ---
# BTS_OUTPUT_DIR=outputs

# --- Training hyperparameters ---
# BTS_IMG_HEIGHT=128
# BTS_IMG_WIDTH=128
# BTS_BATCH_SIZE=8
# BTS_EPOCHS=20
# BTS_LEARNING_RATE=0.0001
# BTS_SEED=42
# BTS_VAL_FRACTION=0.15
# BTS_TEST_FRACTION=0.15
